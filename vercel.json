{
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/api/seguranca/(.*)$", "dest": "/api/seguranca/[...path]" },
    { "src": "^/$", "dest": "/" },
    { "src": "^/login(/.*)?$", "dest": "/" },
    { "src": "^/redefinir-senha$", "dest": "/" },
    { "src": "^/dashboard$", "dest": "/" },
    { "src": "^/frotas$", "dest": "/" },
    { "src": "^/frotas/inspecoes(/.*)?$", "dest": "/" },
    { "src": "^/seguranca$", "dest": "/" },
    { "src": "^/seguranca(/.*)?$", "dest": "/" },
    { "src": "^/perfil(/.*)?$", "dest": "/" },
    { "src": "^/configuracoes$", "dest": "/" }
  ]
}

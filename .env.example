# Braseg Portal — variáveis de ambiente
# Neon (Lakebase Postgres): DATABASE_URL (pooled) e DATABASE_URL_UNPOOLED (direct)
# são injetadas automaticamente pela integração Neon do Vercel. Para rodar
# migrations localmente, use DATABASE_URL_UNPOOLED (host sem "-pooler").
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk (auth) — publishable vai para o client; secret só no servidor
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# DHChat (módulo externo)
VITE_DHCHAT_URL=https://dhchat.domhubs.com.br

# Legado (será removido na migração supabase-js → API):
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
